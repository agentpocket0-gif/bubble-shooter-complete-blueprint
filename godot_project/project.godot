; Engine configuration file.
config_version=5

[application]
config/name="Bubble Shooter: Classic Blast"
config/description="An original offline bubble-popping puzzle game."
config/icon="res://assets/own/ui/app_icon.svg"
run/main_scene="res://scenes/Splash.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/version="1.0.0"

[autoload]
GameState="*res://autoload/GameState.gd"
AssetRegistry="*res://autoload/AssetRegistry.gd"
MonetizationConfig="*res://autoload/MonetizationConfig.gd"

[display]
window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=540
window/size/window_height_override=960
window/handheld/orientation=1
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.13, 1)
